# Sahitya Sangam Environment Configuration
# Copy this file to .env and update with your actual credentials
# DO NOT commit .env file to version control!

# Database Configuration
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=sahitya_db

# Email Configuration (PHPMailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="Sahitya Sangam"
MAIL_ENCRYPTION=tls

# Application Settings
APP_NAME="Sahitya Sangam"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/Sahitya_Sangam2

# Session Settings
SESSION_LIFETIME=120
